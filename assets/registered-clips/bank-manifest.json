    "scene_heading_policy": "Opening horn interval: car_horn; otherwise ordinary_speech per requested clip presentation. This annotation never replaces classifier probabilities.",
    "cues": [
      {
        "id": "d01",
        "start": 0.0,
        "end": 2.5,
        "speaker": "A",
        "text": "今天晚上做什么菜吃呀？"
      },
      {
        "id": "d02",
        "start": 3.16,
        "end": 4.92,
        "speaker": "B",
        "text": "有几个人？我买菜。"
      },
      {
        "id": "d03",
        "start": 7.84,
        "end": 9.65,
        "speaker": "A",
        "text": "我想吃蔬菜。"
      },
      {
        "id": "d04",
        "start": 10.82,
        "end": 12.14,
        "speaker": "C",
        "text": "按半天没听见啊？"
      },
      {
        "id": "d05",
        "start": 12.14,
        "end": 12.6,
        "speaker": "C",
        "text": "喂！"
      },
      {
        "id": "d06",
        "start": 13.62,
        "end": 14.2,
        "speaker": "C",
        "text": "喂！"
      },
      {
        "id": "d07",
        "start": 18.38,
        "end": 20.24,
        "speaker": "C",
        "text": "喂，你怎么回事？"
      },
      {
        "id": "d08",
        "start": 20.24,
        "end": 22.1,
        "speaker": "C",
        "text": "我按了半天喇叭，你们听不到啊？"
      },
      {
        "id": "d09",
        "start": 24.04,
        "end": 25.52,
        "speaker": "C",
        "text": "指耳朵什么意思？"
      },
      {
        "id": "d10",
        "start": 25.52,
        "end": 27.1,
        "speaker": "C",
        "text": "没看到我车过来吗？"
      },
      {
        "id": "d11",
        "start": 28.1,
        "end": 29.5,
        "speaker": "B",
        "text": "我们俩都听不见。"
      },
      {
        "id": "d12",
        "start": 31.26,
        "end": 32.66,
        "speaker": "C",
        "text": "和你们说话呢。"
      },
      {
        "id": "d13",
        "start": 32.66,
        "end": 34.3,
        "speaker": "C",
        "text": "为什么不说？听不见吗？"
      },
      {
        "id": "d14",
        "start": 38.32,
        "end": 40.6,
        "speaker": "C",
        "text": "真的听不见？"
      },
      {
        "id": "d15",
        "start": 86.68,
        "end": 89.98,
        "speaker": "B",
        "text": "我们以后在路上可得注意安全啊。"
      },
      {
        "id": "d16",
        "start": 90.56,
        "end": 92.1,
        "speaker": "B",
        "text": "最好是走人行道。"
      },
      {
        "id": "d17",
        "start": 93.5,
        "end": 95.2,
        "speaker": "A",
        "text": "是啊，可得小心。"
      },
      {
        "id": "d18",
        "start": 95.2,
        "end": 96.96,
        "speaker": "A",
        "text": "出了事故更麻烦。"
      },
      {
        "id": "d19",
        "start": 96.96,
        "end": 98.24,
        "speaker": "A",
        "text": "本来就听不见。"
      },
      {
        "id": "d20",
        "start": 98.24,
        "end": 100.28,
        "speaker": "A",
        "text": "可不能再出身体上的问题。"
      },
      {
        "id": "d21",
        "start": 100.28,
        "end": 102.44,
        "speaker": "B",
        "text": "如果我能听见就好了。"
      },
      {
        "id": "d22",
        "start": 102.44,
        "end": 103.84,
        "speaker": "A",
        "text": "那能怎么办？"
      },
      {
        "id": "d23",
        "start": 103.84,
        "end": 105.26,
        "speaker": "A",
        "text": "认命了，走吧。"
      }
    ]
