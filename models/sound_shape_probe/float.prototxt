name: "sound_shape_probe_float"
layer {
  name: "calibration_input"
  type: "ImageData"
  top: "data"
  top: "label"
  image_data_param {
    source: "calibration/list.txt"
    root_folder: "calibration/images/"
    batch_size: 1
    new_height: 64
    new_width: 96
    is_color: false
    shuffle: false
  }
  transform_param { scale: 0.0078431372549 mean_value: 128 }
}

layer {
  name: "conv1"
  type: "Convolution"
  bottom: "data"
  top: "conv1"
  convolution_param { num_output: 16 kernel_size: 3 pad: 1 stride: 1 bias_term: true }
}
layer {
  name: "relu1"
  type: "ReLU"
  bottom: "conv1"
  top: "conv1"
}
layer {
  name: "pool1"
  type: "Pooling"
  bottom: "conv1"
  top: "pool1"
  pooling_param { pool: MAX kernel_size: 2 stride: 2 }
}

layer {
  name: "conv2"
  type: "Convolution"
  bottom: "pool1"
  top: "conv2"
  convolution_param { num_output: 32 kernel_size: 3 pad: 1 stride: 1 bias_term: true }
}
layer {
  name: "relu2"
  type: "ReLU"
  bottom: "conv2"
  top: "conv2"
}
layer {
  name: "pool2"
  type: "Pooling"
  bottom: "conv2"
  top: "pool2"
  pooling_param { pool: MAX kernel_size: 2 stride: 2 }
}

layer {
  name: "conv3"
  type: "Convolution"
  bottom: "pool2"
  top: "conv3"
  convolution_param { num_output: 64 kernel_size: 3 pad: 1 stride: 1 bias_term: true }
}
layer {
  name: "relu3"
  type: "ReLU"
  bottom: "conv3"
  top: "conv3"
}
layer {
  name: "pool3"
  type: "Pooling"
  bottom: "conv3"
  top: "pool3"
  pooling_param { pool: MAX kernel_size: 2 stride: 2 }
}

layer {
  name: "conv4"
  type: "Convolution"
  bottom: "pool3"
  top: "conv4"
  convolution_param { num_output: 96 kernel_size: 3 pad: 1 stride: 1 bias_term: true }
}
layer {
  name: "relu4"
  type: "ReLU"
  bottom: "conv4"
  top: "conv4"
}
layer {
  name: "pool4"
  type: "Pooling"
  bottom: "conv4"
  top: "pool4"
  pooling_param { pool: MAX kernel_size: 2 stride: 2 }
}

layer {
  name: "logits"
  type: "InnerProduct"
  bottom: "pool4"
  top: "logits"
  inner_product_param { num_output: 8 }
}
