          "line": 69,
          "quote": "case \"$hop_samples\" in 4000|6400|8000|12000) :;; *) echo 'unsupported hop samples' >&2; exit 65;; esac"
        },
        {
          "line": 70,
          "quote": "cadence_ms=$((hop_samples / 16))"
        },
        {
          "line": 140,
          "quote": "    soundjie-alert4bg-v2|soundjie-alert5bg-v3) set -- --period-size=800 --buffer-size=8000;;"
        },
        {
          "line": 144,
          "quote": "    -D \"${SOUNDJIE_PCM_DEVICE:-hw:0,0}\" -t raw -f S16_LE -c 2 -r 16000 \"$@\""
        },
        {
          "line": 150,
          "quote": "  --window-samples 16000 --hop-samples \"$hop_samples\" --cadence-ms \"$cadence_ms\" \\"
